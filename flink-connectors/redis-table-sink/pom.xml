<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Same "Flink cluster infrastructure, not a business job" category as
    ../clickhouse-jdbc-dialect - see that module's own pom.xml comment for
    the general reasoning (standalone build, shaded into an uber jar dropped
    into the Flink cluster's lib/ directory).

    Unlike ClickHouse/Doris/MySQL/Oracle, Redis isn't a JDBC-queryable engine
    at all, so this can't just teach flink-connector-jdbc a new dialect -
    it's a full DynamicTableSinkFactory/DynamicTableSink/SinkFunction
    written against Jedis directly (Apache Bahir's flink-connector-redis was
    evaluated and rejected: it only exposes a DataStream-API RedisSink, no
    Table/SQL connector factory, so it can't be referenced from a
    'connector'='...' WITH clause the way SQL 流作业 generates sink DDL).

    Mapping: one Redis key per sink row (key = key-prefix + primary key
    column value(s)), written via HSET with one hash field per table column
    - the natural fit for a keyed upsert stream (mirrors a CDC changelog
    row), and lets 实时数据查询's Redis command box read it straight back
    with HGETALL. DELETE-kind rows (retractions) issue a plain DEL.
  -->

  <groupId>com.company.flinkconnectors</groupId>
  <artifactId>redis-table-sink</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <flink.version>1.19.3</flink.version>
    <!-- matches the flink:1.19 (-> 1.19.3) cluster in docker/bigdata/docker-compose.yml -->
  </properties>

  <dependencies>
    <!-- Already on the Flink cluster's classpath - compiled against, not
         bundled, same reasoning as clickhouse-jdbc-dialect's pom.xml. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-common</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- org.apache.flink.api.connector.sink2.* (the Sink V2 API this
           connector implements) lives here, not flink-streaming-java. -->
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-core</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Not on the cluster classpath - must be shaded into the connector jar -->
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
      <version>5.1.5</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
      <version>2.12.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>redis-table-sink</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <!-- Same reasoning as clickhouse-jdbc-dialect's pom.xml -
                     merges this module's own SPI file with anything else on
                     the classpath instead of one silently overwriting the
                     other. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
