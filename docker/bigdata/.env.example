# Copy to ".env" (gitignored, see root .gitignore) and fill in real values
# before running `docker compose up`. This file has no secrets in it and is
# safe to commit - it only documents which variables the stack requires.

MYSQL_ROOT_PASSWORD=changeme
DEBEZIUM_PASSWORD=changeme
REPL_PASSWORD=changeme

CLICKHOUSE_PASSWORD=changeme

ORACLE_PASSWORD=changeme
ORACLE_APP_USER_PASSWORD=changeme

REDIS_PASSWORD=changeme

MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# Must match kafka-tls/certs/creds.txt, written by kafka-tls/generate-certs.sh
KAFKA_TLS_PASSWORD=changeme
