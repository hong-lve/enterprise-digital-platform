<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Shared Kafka+Debezium plumbing (CdcMirrorSupport) for the five
    cdc-mirror-* sink modules (cdc-mirror-clickhouse/oracle/mysql/redis/
    doris) - split out of what used to be one cdc-mirror-job module with
    five main classes, so each sink ships as its own independently
    deployable/upgradable jar instead of all five (and every sink's JDBC
    driver) bundled together. A plain (unshaded) library jar, not an
    executable - `mvn install`ed to the local repo so the five sink modules
    can depend on it by Maven coordinates like any other dependency.
  -->

  <groupId>com.company.flinkjobs</groupId>
  <artifactId>cdc-mirror-common</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <flink.version>1.19.3</flink.version>
  </properties>

  <!-- io.confluent artifacts (kafka-avro-serializer below) aren't on Maven
       Central - Confluent publishes them from their own repo only. -->
  <repositories>
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>3.3.0-1.19</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.1</version>
    </dependency>
    <!--
      Decodes the Avro+Confluent-Schema-Registry wire format Kafka Connect's
      AvroConverter now writes (magic byte + 4-byte schema id + Avro binary) -
      the schema id is resolved against the registry at runtime by this
      client itself, so CdcMirrorSupport.sourceRows() doesn't need to know
      any table's schema ahead of time, same dynamic-row-shape behavior the
      old Jackson JsonNode-based parsing had for plain JSON.
    -->
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
      <version>7.6.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <!--
      MockSchemaRegistryClient - an in-memory fake of the Schema Registry HTTP
      API - lets DebeziumAvroRowExtractorTest encode/decode real Confluent-wire-
      format Avro (magic byte + schema id + binary) entirely inside the JVM, no
      running registry needed. Pinned to the same version as kafka-avro-serializer
      above since it's normally just a transitive dep of it; listed explicitly
      here because test code compiles against it directly.
    -->
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-schema-registry-client</artifactId>
      <version>7.6.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
